From 371a2be8fbb1523df2ab33a2882b077ebde4e637 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Mon, 31 Aug 2026 07:21:06 +0000
Subject: [PATCH] Fix PageSpeed-flagged issues: forced reflow, CLS, legacy JS,
 hero image size

- ScrollStack.jsx: remove redundant scroll-driven getBoundingClientRect()
  active-project detection. ScrollStackItem's IntersectionObserver already
  does this identically without forcing synchronous layout every frame.
- CaseStudyCard.jsx: seed initial aspect ratio at the real project video
  ratio (640/426 ~= 1.50) instead of a guessed 16/10 (1.6), eliminating
  the ~6%% height snap once video metadata loads (CLS contributor).
- package.json: add browserslist targeting evergreen browsers so Next
  stops shipping legacy transpilation/polyfills for old browser targets.
- character_glare.webp: re-encode all 19 frames at q50 (519KB -> 414KB),
  verified visually lossless (mean RGB diff ~3.5/255 across all frames,
  frame count/canvas/alpha preserved).
- public/_headers: long-lived cache headers for static assets, effective
  if the site is ever hosted on Netlify/Cloudflare Pages (GitHub Pages
  ignores this file and has a fixed ~10min Cache-Control with no
  per-file override).
---
 components/CaseStudyCard.jsx |  10 ++-
 components/ScrollStack.jsx   | 116 ++++-------------------------------
 package.json                 |   8 ++-
 public/_headers              |  20 ++++++
 public/character_glare.webp  | Bin 518704 -> 423630 bytes
 5 files changed, 47 insertions(+), 107 deletions(-)
 create mode 100644 public/_headers

diff --git a/components/CaseStudyCard.jsx b/components/CaseStudyCard.jsx
index 0eb6122..5a2bc83 100644
--- a/components/CaseStudyCard.jsx
+++ b/components/CaseStudyCard.jsx
@@ -89,8 +89,16 @@ export default function CaseStudyCard({
   href = '#',
   videoSrc,
 }) {
+  /*
+  --------------------------------------------------------------------------
+  Seed with the real project video ratio (640/426 ≈ 1.50), not a guessed
+  16/10 (1.6). The old guess caused a ~6% height snap on every card once
+  the video's actual metadata loaded — a measured CLS contributor flagged
+  by PageSpeed. Images fall back to their own measured ratio below anyway.
+  --------------------------------------------------------------------------
+  */
   const [ratio, setRatio] =
-    useState(16 / 10);
+    useState(640 / 426);
 
   const [failed, setFailed] =
     useState(false);
diff --git a/components/ScrollStack.jsx b/components/ScrollStack.jsx
index e5e7da7..61d6055 100644
--- a/components/ScrollStack.jsx
+++ b/components/ScrollStack.jsx
@@ -144,111 +144,17 @@ export default function ScrollStack({
   const items = Children.toArray(children);
   const containerRef = useRef(null);
 
-  useEffect(() => {
-    const container = containerRef.current;
-
-    if (!container || !onActiveChange) {
-      return undefined;
-    }
-
-    let ticking = false;
-
-    /*
-    ------------------------------------------------------------------------
-    Find active project
-    ------------------------------------------------------------------------
-    */
-
-    const updateActive = () => {
-      ticking = false;
-
-      const elements = Array.from(
-        container.querySelectorAll(
-          '[data-project-index]'
-        )
-      );
-
-      if (!elements.length) {
-        return;
-      }
-
-      const viewportCenter =
-        window.innerHeight / 2;
-
-      let closestIndex = 0;
-      let closestDistance = Infinity;
-
-      elements.forEach((element) => {
-        const rect =
-          element.getBoundingClientRect();
-
-        const center =
-          rect.top + rect.height / 2;
-
-        const distance = Math.abs(
-          center - viewportCenter
-        );
-
-        if (distance < closestDistance) {
-          closestDistance = distance;
-
-          closestIndex = Number(
-            element.dataset.projectIndex
-          );
-        }
-      });
-
-      onActiveChange(closestIndex);
-    };
-
-    /*
-    ------------------------------------------------------------------------
-    RAF throttle
-    ------------------------------------------------------------------------
-    */
-
-    const handleScroll = () => {
-      if (ticking) {
-        return;
-      }
-
-      ticking = true;
-
-      window.requestAnimationFrame(
-        updateActive
-      );
-    };
-
-    window.addEventListener(
-      'scroll',
-      handleScroll,
-      {
-        passive: true,
-      }
-    );
-
-    window.addEventListener(
-      'resize',
-      handleScroll,
-      {
-        passive: true,
-      }
-    );
-
-    updateActive();
-
-    return () => {
-      window.removeEventListener(
-        'scroll',
-        handleScroll
-      );
-
-      window.removeEventListener(
-        'resize',
-        handleScroll
-      );
-    };
-  }, [onActiveChange]);
+  /*
+  --------------------------------------------------------------------------
+  Active-project detection is handled entirely by each ScrollStackItem's
+  own IntersectionObserver (see above), which calls onActiveChange directly.
+  This component used to ALSO run a scroll-driven getBoundingClientRect()
+  scan across every item on every scroll frame (RAF-throttled) to do the
+  exact same job — a forced-synchronous-layout pattern flagged by
+  PageSpeed. Removed as fully redundant: the IntersectionObserver path
+  produces identical visible behavior with none of the layout cost.
+  --------------------------------------------------------------------------
+  */
 
   return (
     <>
diff --git a/package.json b/package.json
index d176e0e..3cc3e5a 100644
--- a/package.json
+++ b/package.json
@@ -25,5 +25,11 @@
     "eslint-config-next": "14.2.35",
     "postcss": "^8.4.47",
     "tailwindcss": "^3.4.13"
-  }
+  },
+  "browserslist": [
+    "chrome >= 90",
+    "edge >= 90",
+    "firefox >= 88",
+    "safari >= 14"
+  ]
 }
diff --git a/public/_headers b/public/_headers
new file mode 100644
index 0000000..3f54d7a
--- /dev/null
+++ b/public/_headers
@@ -0,0 +1,20 @@
+# Long-lived cache headers for static, content-hashed-by-path assets.
+# GitHub Pages does not read this file (fixed ~10min Cache-Control, no
+# per-file override available) — this only takes effect if the site is
+# ever served from a host that honors _headers, e.g. Netlify or
+# Cloudflare Pages. Flagged by PageSpeed as "Use efficient cache
+# lifetimes" (~1MB opportunity); this is the fix for that host class.
+# On GitHub Pages, the real fix is fronting the domain with Cloudflare
+# and setting a Cache Rule / Edge TTL for /public assets.
+
+/*.webp
+  Cache-Control: public, max-age=31536000, immutable
+
+/*.mp4
+  Cache-Control: public, max-age=31536000, immutable
+
+/*.png
+  Cache-Control: public, max-age=31536000, immutable
+
+/*.svg
+  Cache-Control: public, max-age=31536000, immutable
